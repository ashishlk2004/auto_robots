// Use this devcontainer.json to develop within a standard Docker environment,
// with VNC providing the GUI support.
// It uses the prebuilt image from the GitHub Container Registry,
// so does not require a Dockerfile.
{
  "name": "auro-vnc",
  "image": "ghcr.io/uoy-robostar/ros2-tb3/auro-dev:latest",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE},target=/home/ubuntu/homedir,type=bind"
  ],
  "remoteUser": "ubuntu",
  "portsAttributes": {
      "6080": {
          "label": "Desktop"
      }
  },
  "postStartCommand": "touch /workspaces/.bash_history && ln -sf /workspaces/.bash_history /home/ubuntu/.bash_history ; /workspaces/${localWorkspaceFolderBasename}/.devcontainer/gitconfig.sh",
  "remoteEnv": {
    "USERNAME": "${localEnv:USERNAME}",
    "USERDNSDOMAIN": "${localEnv:USERDNSDOMAIN}"
  },
  "containerEnv": {
    "VNC_RESOLUTION": "1280x720x24"
  },
  "customizations": {
    "auro": {
      "scenarios": [
        {
          "name": "Scenario 1",
          "description": "Baseline: a single robot with Nav2 and no sensor noise. Exercises the complete search / collect / deliver / decontaminate pipeline end to end.",
          "parameters": {
            "num_robots": 1,
            "use_nav2": "true",
            "sensor_noise": "false",
            "use_rviz": "false"
          }
        },
        {
          "name": "Scenario 2",
          "description": "Full team: three robots with Nav2. Exercises decentralised coordination - shared barrel sightings, target claiming, and collection zone allocation - plus robot-robot avoidance in the corridors.",
          "parameters": {
            "num_robots": 3,
            "use_nav2": "true",
            "sensor_noise": "false",
            "use_rviz": "false"
          }
        },
        {
          "name": "Scenario 3",
          "description": "Perception and localisation robustness: two robots with sensor noise enabled (camera, LiDAR and IMU) and wheel-encoder odometry, so AMCL must correct drift and the vision pipeline must reject noisy detections.",
          "parameters": {
            "num_robots": 2,
            "use_nav2": "true",
            "sensor_noise": "true",
            "odometry_source": "ENCODER",
            "use_rviz": "false"
          }
        },
        {
          "name": "Scenario 4",
          "description": "Generality: a different random seed changes the barrel cluster layout, and the static obstacles in the west room are removed (the controllers must not depend on a fixed item distribution; the obstacle layer sees an emptier room). Two robots favour blue barrels via red_penalty, testing the contamination-minimisation bias.",
          "parameters": {
            "num_robots": 2,
            "use_nav2": "true",
            "random_seed": 42,
            "obstacles": "false",
            "red_penalty": "2.0",
            "sensor_noise": "false",
            "use_rviz": "false"
          }
        },
        {
          "name": "Scenario 5",
          "description": "Degraded navigation (fault tolerance): Nav2 disabled, so the controller falls back to its internal waypoint-graph navigator with reactive LiDAR avoidance, using idealised WORLD odometry. Demonstrates the system still completes deliveries without the navigation stack.",
          "parameters": {
            "num_robots": 1,
            "use_nav2": "false",
            "odometry_source": "WORLD",
            "sensor_noise": "false",
            "use_rviz": "false"
          }
        }
      ]
    }
  }
}